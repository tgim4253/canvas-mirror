{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Canvas Mirror Studio",
  "version": "0.3.10",
  "identifier": "io.canvasmirror.studio",
  "build": {
    "beforeDevCommand": "pnpm --filter @canvas-mirror/manager-tauri vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @canvas-mirror/manager-tauri build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Canvas Mirror Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2Qjc3NkJGNjVBOTBDMjEKUldRaERLbGx2M2EzNXJKWVA1ZUlmZHN6MUxvRjh1OGZrWDZNaEYvSExLSEJVZlNld0Fwd1daZEkK",
      "endpoints": [
        "https://github.com/tgim4253/canvas-mirror/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
