{
  "name": "canvas-mirror-workspace",
  "version": "0.1.5",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @canvas-mirror/manager-tauri dev",
    "build:front": "pnpm --filter @canvas-mirror/manager-tauri build",
    "tauri": "pnpm --filter @canvas-mirror/manager-tauri tauri",
    "version:bump": "node scripts/bump-version.mjs",
    "ui:demo": "pnpm --filter @canvas-mirror/manager-tauri ui:demo",
    "locale:build": "pnpm --filter @canvas-mirror/scripts translate",
    "locale:xlsx": "pnpm --filter @canvas-mirror/scripts extract-translation"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.7.1"
  }
}
